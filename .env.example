# ------------------------------------------------------------------
# Environment variables for the portfolio (visit-notification feature)
# Copy this file to `.env` and fill in real values.
# In production, set these in the Vercel dashboard instead
# (Project → Settings → Environment Variables).
# ------------------------------------------------------------------

# Resend API key — REQUIRED for the visit email to actually send.
# Get one at https://resend.com (Dashboard → API Keys).
RESEND_API_KEY=

# Where visit notifications are emailed. Defaults to the address below if unset.
NOTIFY_TO=zulqarnainishaq400@gmail.com

# The "from" address Resend sends as.
# `onboarding@resend.dev` works for testing (delivers only to your Resend account email).
# For production, verify your own domain in Resend and use e.g. visits@yourdomain.com
NOTIFY_FROM=onboarding@resend.dev
